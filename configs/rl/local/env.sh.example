# Machine-local environment for RL-100 zarr live collect / real deploy.
#
# Copy this file to env.sh and fill in your robot's values:
#   cp configs/rl/local/env.sh.example configs/rl/local/env.sh
#   # edit env.sh
#
# env.sh is gitignored (configs/rl/local/* except .gitkeep and this .example).
# Sourced by:
#   scripts/rl/run_rl100_zarr_collect.sh
#   scripts/rl/run_rl100_real.sh
# Also source in the camera terminal before roslaunch:
#   source configs/rl/local/env.sh
#
# Values here override the script defaults via ${VAR:-default} fallbacks.

# Resolve repo root whether this file is sourced as configs/rl/local/env.sh
# or via an absolute path.
_RL100_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_RL100_ROOT="$(cd "${_RL100_ENV_DIR}/../../.." && pwd)"

# --- ROS networking (robot side) ---------------------------------------------
# Master on the robot controller. Default in script: http://kuavo_master:11311
export ROS_MASTER_URI="${ROS_MASTER_URI:-http://kuavo_master:11311}"

# This machine's IP on the robot network. Default in script: 192.168.26.12
export ROS_IP="${ROS_IP:-192.168.26.12}"

# --- Wrist cameras (RealSense D405 serials) ---------------------------------
# Required by configs/launch/hil_upper_cams.launch via $(env ...).
# Find serials with: rs-enumerate-devices --compact | grep Serial
export LEFT_WRIST_CAMERA_SERIAL_NO="REPLACE_ME_LEFT_SERIAL"
export RIGHT_WRIST_CAMERA_SERIAL_NO="REPLACE_ME_RIGHT_SERIAL"

# --- CUDA 11.4 staging (Jetson Orin / torch built for CUDA 11.4) -------------
# If conda torch reports cuda=11.4 but the host only has CUDA 12, place the
# CUDA 11.4 + cuDNN 8 shared libs under:
#   <repo>/.runtime_staging/cuda11.4/usr/local/cuda-11.4/targets/sbsa-linux/lib
#   <repo>/.runtime_staging/cuda11.4/usr/lib/aarch64-linux-gnu
# run_rl100_real.sh also auto-prepends this path when the directory exists.
_CUDA114="${_RL100_ROOT}/.runtime_staging/cuda11.4"
if [[ -d "${_CUDA114}/usr/local/cuda-11.4/targets/sbsa-linux/lib" ]]; then
  export LD_LIBRARY_PATH="${_CUDA114}/usr/local/cuda-11.4/targets/sbsa-linux/lib:${_CUDA114}/usr/lib/aarch64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
unset _CUDA114 _RL100_ENV_DIR _RL100_ROOT

# --- Optional: which collect config to use ----------------------------------
# export RL100_CFG="configs/rl/rl100_zarr_collect_upper_cams.yaml"
